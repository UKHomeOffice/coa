{
  "name": "change-of-address",
  "version": "1.0.0",
  "description": "A service for changing address",
  "main": "index.js",
  "engines": {
    "node": ">=24.18.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test:ui-integration": "NODE_ENV=test _mocha \"test/_ui-integration/**/*.spec.js\" --exit",
    "start:dev": "hof-build watch --env",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "LOG_LEVEL=error nyc _mocha \"test/_unit/**/*.spec.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/coa.git"
  },
  "author": "HOF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/coa/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/coa#readme",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "bl": "^6.1.4",
    "busboy": "^1.6.0",
    "crypto-random-string": "^6.0.0",
    "form-data": "4.0.6",
    "hof": "~24.5.0",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "jquery": "^4.0.0",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "supertest": "^7.2.2",
    "supertest-session": "^5.0.1"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/setup.js",
    "recursive": "true",
    "timeout": "6000"
  }
}
