{
  "name": "change-of-address",
  "version": "1.0.0",
  "description": "A service for changing address",
  "main": "index.js",
  "engines": {
    "node": ">=24.19.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test:ui-integration": "NODE_ENV=test _mocha \"test/_ui-integration/**/*.spec.js\" --exit",
    "start:dev": "hof-build watch --env",
    "build": "hof-build",
    "postinstall": "hof-build",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:smoke": "bddgen && playwright test --grep-invert @history",
    "test:e2e:history": "bddgen && playwright test --grep @history",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "LOG_LEVEL=error nyc _mocha \"test/_unit/**/*.spec.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/coa.git"
  },
  "author": "HOF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/coa/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/coa#readme",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "bl": "^6.1.4",
    "busboy": "^1.6.0",
    "crypto-random-string": "^6.0.0",
    "form-data": "4.0.6",
    "hof": "~24.5.0",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.1",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "jquery": "^4.0.0",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "playwright-bdd": "^9.2.0",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "supertest": "^7.2.2",
    "supertest-session": "^5.0.1"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/setup.js",
    "recursive": "true",
    "timeout": "6000"
  }
}
